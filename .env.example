# ========================================================
# VocalSync AI — Production Deployment Configuration
# ========================================================

# Google Gemini API key for meeting intelligence summarization & debrief
GEMINI_API_KEY=your_gemini_api_key_here

# Hugging Face token (optional, for gated SpeechBrain models if needed)
HF_TOKEN=your_huggingface_token_here

# Backend Service Configuration
PORT=8000
HOST=0.0.0.0
VOICE_PROFILES_DIR=./backend/voice_profiles
ASR_MODEL_SIZE=small.en

# Frontend Configuration (baked into static build)
# For local Docker:
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/meeting

# For Cloud / Domain Deployment (with HTTPS/WSS):
# VITE_API_BASE_URL=https://api.yourdomain.com
# VITE_WS_URL=wss://api.yourdomain.com/ws/meeting
